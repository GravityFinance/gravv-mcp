# Copy to .env for local development. NEVER commit a real key.
# The key decides the environment — sandbox and live share one base URL.
GRAVV_API_KEY=grvSec_sandbox_replace_me

# Required before money-moving tools will execute against a LIVE key.
# GRAVV_ALLOW_LIVE_WRITES=true

# Client-side throttle. The gateway allows 600/min, burst 50, per tenant.
# GRAVV_RATE_PER_MINUTE=60
# GRAVV_TOOLSETS=customers,accounts,transfers

# Where the documentation tools read the docs (llms.txt and llms-full.txt).
# GRAVV_DOCS_ORIGIN=https://gravv-docs.syntext.dev
