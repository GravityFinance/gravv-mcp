{
  "name": "@gravvfi/mcp",
  "version": "0.2.2",
  "description": "MCP server for the Gravv payments API — onboard customers, open accounts, move money, issue cards.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://gravv-docs.syntext.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GravityFinance/gravv-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/GravityFinance/gravv-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "gravv",
    "payments",
    "stablecoin",
    "fintech"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "gravv-mcp": "dist/bin/gravv-mcp.js"
  },
  "main": "dist/server.js",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "sync-specs": "node --experimental-strip-types scripts/sync-specs.ts",
    "generate": "node --experimental-strip-types scripts/generate.ts",
    "build": "npm run generate && tsc",
    "dev": "node --experimental-strip-types src/bin/gravv-mcp.ts",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
